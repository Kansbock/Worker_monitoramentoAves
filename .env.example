# Configuração AWS
# Perfil AWS IAM Identity Center (SSO) já autenticado via `aws sso login --profile <perfil>`.
# Nunca use chaves de acesso permanentes aqui.
AWS_PROFILE=aves-worker
AWS_REGION=us-east-1

# Bucket do comedouro. Apenas objetos na raiz são processados; "app/", "Upload/",
# "Fotos salvas/" e as pastas de destino por espécie nunca são lidos como entrada.
S3_BUCKET=comedouro-aves-fotos-tcc-2026

# API Aves (Spring Boot em AWS Lambda/API Gateway ou ambiente local/homologação).
API_BASE_URL=https://iofgiiaolc.execute-api.us-east-1.amazonaws.com

# Conta de serviço exclusiva do worker. Criada uma única vez por
# `feeder-worker bootstrap-service-user` e usada em todo login subsequente.
API_USER_NAME=Feeder Worker
API_USER_EMAIL=feeder-worker@example.com
API_USER_PASSWORD=troque-por-uma-senha-forte

# Caminho local do modelo treinado (.keras). Para o modelo de 4 saídas,
# copie também class_names.json para a mesma pasta. Nunca versione esses arquivos.
MODEL_PATH=./models/model.keras

# Caminho do banco SQLite de estado/retomada do worker.
STATE_DB_PATH=./state/feeder_worker.db

# Parâmetros operacionais (valores abaixo são os padrões recomendados).
POLL_INTERVAL_SECONDS=60
MAX_IMAGES_PER_CYCLE=10
# Aplica-se apenas às 3 espécies; a classe Outros sempre vai para background/.
CONFIDENCE_THRESHOLD=0.85
CAPTURE_TIMEZONE=America/Sao_Paulo
